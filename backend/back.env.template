# Copy to backend/back.env. backend/app/config.py is the only reader of this file.
# Provision the Vultr VM manually; no VM credentials or coupon belong here.

# Vultr Serverless Inference: used by every agent LLM call.
# Add your inference API key only to back.env, never to this template.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=qwen3.8-flash-next
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=60
# Maximum agent code-repair retries after the initial execution fails.
AGENT_MAX_REPAIR_RETRIES=1

# Docker sandbox: build this local image before running tasks.
SANDBOX_IMAGE=ml-assistant-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMPFS_MB=256
SANDBOX_MAX_OUTPUT_MB=64
# The runner must enforce network isolation, non-root execution, a read-only
# root filesystem, no credentials or Docker socket, and per-task destruction.
# These are mandatory runner policies, not configurable opt-out switches.

# Upload limit enforced by the backend as well as the frontend (MiB).
BACKEND_MAX_UPLOAD_MB=25

# Temporary storage only; resolve this path relative to the repository root.
# Use unique session subdirectories. No session recovery or persistent history.
SESSION_TEMP_ROOT=.runtime/sessions
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=7200
SESSION_CLEANUP_INTERVAL_SECONDS=60
MAX_ACTIVE_SESSIONS=10
SESSION_MAX_STORAGE_MB=256
# End-session deletion is immediate; expired/abandoned sessions are swept.
# Delete session files, models, reports, logs, and leftover task containers.

# Server settings used by: uv run python -m app
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Set true behind HTTPS on the public Vultr deployment; false for local HTTP.
COOKIE_SECURE=false
