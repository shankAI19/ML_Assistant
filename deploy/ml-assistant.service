[Unit]
Description=ML Assistant FastAPI control plane
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=mlassistant
Group=mlassistant
SupplementaryGroups=docker
WorkingDirectory=/opt/ml-assistant/backend
# uv sync installs the project environment before this service is started.
ExecStart=/opt/ml-assistant/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
